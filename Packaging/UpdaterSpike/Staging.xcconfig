ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO
MACOSX_DEPLOYMENT_TARGET = 13.0
DEVELOPMENT_TEAM = S898B9KBWN
ENABLE_HARDENED_RUNTIME = YES
INFOPLIST_KEY_SUFeedURL = https:/$()/synok522-del.github.io/AIUsageBar/staging/u1-20260915/appcast.xml
